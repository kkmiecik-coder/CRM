<!--
  Konfiguracja WinSW (v2.12.0) usługi agenta druku. Instalator kładzie ją obok
  AgentDrukuUsluga.exe (to WinSW-x64.exe pod inną nazwą — WinSW czyta plik XML o tej samej nazwie).
  Usługa działa jako LocalSystem (domyślne konto WinSW). Zatrzymanie: WinSW wysyła Ctrl+C,
  AgentDruku.exe kończy pętlę i zamyka lokalne API.
-->
<service>
  <id>WoodPowerAgentDruku</id>
  <name>WoodPower Agent druku</name>
  <description>Drukuje etykiety produktów i paczek z kolejki CRM WoodPower na drukarkach hali.</description>
  <executable>%BASE%\AgentDruku.exe</executable>
  <arguments>service</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>15 sec</stoptimeout>
  <logpath>%ProgramData%\WoodPower\AgentDruku\logi</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>1024</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
