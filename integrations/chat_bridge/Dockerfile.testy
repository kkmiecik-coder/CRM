# Obraz WYŁĄCZNIE do uruchamiania testów mostka lokalnie.
# Ten sam Python i te same zależności co produkcja (Dockerfile), plus pytest.
# Kod NIE jest kopiowany — montujemy go wolumenem, żeby edycja pliku nie
# wymagała przebudowy obrazu.
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt pytest
CMD ["python", "-m", "pytest", "tests/", "-q"]
