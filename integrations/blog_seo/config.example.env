# Wzor sekretow automatu blogowego. Skopiuj na VPS jako .env (chmod 600, wlasciciel = uzytkownik serwisu).
# NIE commituj wypelnionego pliku. Klucze DEDYKOWANE dla tej integracji (osobne od CRM/mostka).

# --- LLM (tekst) ---
BLOG_LLM_PROVIDER=openai            # openai | anthropic
BLOG_OPENAI_API_KEY=
BLOG_OPENAI_MODEL=gpt-5.4
BLOG_ANTHROPIC_API_KEY=
BLOG_ANTHROPIC_MODEL=claude-opus-4-8   # tansze: claude-sonnet-5 / claude-haiku-4-5
BLOG_MAX_TOKENS=6000

# --- Obrazy ---
BLOG_STOCK_PROVIDER=pexels          # pexels | unsplash
BLOG_STOCK_API_KEY=
BLOG_IMAGE_PROVIDER=none            # none | openai (fallback hero, uzywa BLOG_OPENAI_API_KEY)

# --- Baza PrestaShop (odczyt katalogu + zapis szkicu) ---
BLOG_PS_DB_HOST=127.0.0.1
BLOG_PS_DB_NAME=presta
BLOG_PS_DB_USER=
BLOG_PS_DB_PASS=
BLOG_PS_PREFIX=ps_
BLOG_PS_SHOP_ID=1
BLOG_PS_LANG_IDS=1,2
BLOG_PS_AUTHOR_ID=23
BLOG_PS_DEFAULT_CATEGORY_ID=4

# --- Obrazy na dysku sklepu (modul ETS Simple Blog) ---
BLOG_PS_IMG_DIR=/home/woodpower/htdocs/woodpower.pl/img/ets_blog/post
BLOG_PS_IMG_URL_BASE=https://woodpower.pl/img/ets_blog/post

# --- Sklep / linkowanie / stan ---
BLOG_SHOP_BASE_URL=https://woodpower.pl
BLOG_LINK_CLASS=kontakt-link-descr
BLOG_DB_PATH=/home/woodpower/blog_seo/blog_seo.db
BLOG_MIN_BACKLOG=5
